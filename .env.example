# =============================================================================
# PrescpHealth SaaS Platform — Environment Variables
# =============================================================================
# This file documents ALL environment variables required by the platform.
# Copy this file to .env and fill in actual values for your environment.
#
# SECURITY WARNING: Never commit .env files with real values to version control.
# This .env.example contains only placeholder/example values.
#
# For detailed documentation of each variable, see:
#   docs/deployment/environment-variables.md
# =============================================================================

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Application environment: development | staging | production
# Controls debug mode, log verbosity, and feature flags
APP_ENV=development

# Application name (used in logs and monitoring)
APP_NAME=PrescpHealth

# API version prefix for all routes
API_VERSION=v1

# Host and port for the FastAPI/Uvicorn server
APP_HOST=0.0.0.0
APP_PORT=8000

# Number of Uvicorn worker processes (set to CPU count in production)
UVICORN_WORKERS=1

# Enable/disable OpenAPI docs endpoint (disable in production for security)
ENABLE_DOCS=true

# =============================================================================
# DATABASE - PostgreSQL
# =============================================================================
# PostgreSQL connection for the primary data store.
# Uses asyncpg driver for async operations.
# RLS (Row-Level Security) enforces tenant isolation at the database level.

# Full async connection URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://prescphealth:your_secure_password_here@localhost:5432/prescphealth

# Sync connection URL (used by Alembic migrations only)
DATABASE_URL_SYNC=postgresql://prescphealth:your_secure_password_here@localhost:5432/prescphealth

# Connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# =============================================================================
# REDIS - Cache, Sessions, Rate Limiting, Celery Broker
# =============================================================================
# Redis serves multiple roles: caching, session storage, rate limiting,
# and as the message broker for Celery background tasks.

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# Redis database numbers for logical separation
REDIS_CACHE_DB=0
REDIS_SESSION_DB=1
REDIS_CELERY_DB=2
REDIS_RATE_LIMIT_DB=3

# Cache TTL defaults (seconds)
REDIS_DEFAULT_TTL=300

# =============================================================================
# AUTHENTICATION & SECURITY - JWT Configuration
# =============================================================================
# JWT tokens are used for stateless authentication.
# Access tokens are short-lived (15 min), refresh tokens longer (7 days).
# Refresh token rotation detects reuse attacks.

# Secret key for signing JWT tokens - MUST be a strong random string (min 64 chars)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARACTERS_LONG

# JWT algorithm (HS256 is symmetric - suitable for single-service architecture)
JWT_ALGORITHM=HS256

# Access token lifetime in minutes (15 min per HIPAA session requirements)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days (7 days with rotation)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# bcrypt cost factor for password hashing (12 = ~250ms per hash)
BCRYPT_COST_FACTOR=12

# =============================================================================
# EXTERNAL AI SERVICES
# =============================================================================
# LLM providers for the AI Clinical Assistant.
# GPT-4o is primary; Claude is automatic fallback when GPT-4o is unavailable.
# IMPORTANT: Never send full patient identifiers to LLM APIs.

# OpenAI API key for GPT-4o (primary LLM provider)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model identifier
OPENAI_MODEL=gpt-4o

# OpenAI request timeout in seconds (failover to Claude after this)
OPENAI_TIMEOUT_SECONDS=8

# Anthropic API key for Claude (fallback LLM provider)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Anthropic model identifier
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Anthropic request timeout in seconds
ANTHROPIC_TIMEOUT_SECONDS=12

# =============================================================================
# EMAIL SERVICE - SendGrid
# =============================================================================
# SendGrid handles transactional email: alert notifications, account emails.
# Notification content is minimal (no PHI in emails per HIPAA).
# Retry policy: exponential backoff up to 24 hours before marking failed.

# SendGrid API key
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# Verified sender email address
SENDGRID_FROM_EMAIL=alerts@prescphealth.com

# Sender display name
SENDGRID_FROM_NAME=PrescpHealth Alerts

# =============================================================================
# SMS/WHATSAPP SERVICE - Twilio
# =============================================================================
# Twilio handles SMS and WhatsApp alert notifications.
# Notification content is minimal (no PHI in messages per HIPAA).
# Retry policy: exponential backoff up to 6 hours before marking failed.

# Twilio Account SID
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid_here

# Twilio Auth Token
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio phone number for SMS (E.164 format)
TWILIO_FROM_PHONE=+1234567890

# Twilio WhatsApp sender (must be approved WhatsApp Business number)
TWILIO_WHATSAPP_FROM=whatsapp:+1234567890

# =============================================================================
# CELERY - Background Task Processing
# =============================================================================
# Celery handles async ML inference, notification dispatch, and report generation.
# Uses Redis as broker. Priority lanes: notification > risk > forecast > report.

# Celery broker URL (Redis)
CELERY_BROKER_URL=redis://localhost:6379/2

# Celery result backend URL (Redis)
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Task time limit in seconds (hard kill after this)
CELERY_TASK_TIME_LIMIT=300

# Task soft time limit (raises SoftTimeLimitExceeded, allows cleanup)
CELERY_TASK_SOFT_TIME_LIMIT=270

# Max retries for failed tasks
CELERY_MAX_RETRIES=3

# =============================================================================
# ML MODEL STORAGE
# =============================================================================
# Model artifacts (trained model files) are stored in object storage.
# Each model version is immutable once deployed - enables rollback and audit.

# Object storage type: s3 | local (local for development only)
MODEL_STORAGE_TYPE=local

# S3 bucket for model artifacts (production)
MODEL_STORAGE_S3_BUCKET=prescphealth-models

# S3 region
MODEL_STORAGE_S3_REGION=us-east-1

# AWS credentials (for S3 model storage)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# Local model storage path (development only)
MODEL_STORAGE_LOCAL_PATH=./ml/artifacts

# =============================================================================
# CORS - Cross-Origin Resource Sharing
# =============================================================================
# Allowed origins for the frontend SPA to communicate with the API.
# In production, restrict to the exact frontend domain.

# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# RATE LIMITING
# =============================================================================
# Per-user rate limits to prevent abuse and data harvesting.
# Clinician roles get higher limits; Patient_User gets lower limits.

# Requests per minute for Clinician roles (Doctor, Nurse, Clinic_Admin)
RATE_LIMIT_CLINICIAN=1000

# Requests per minute for Patient_User role
RATE_LIMIT_PATIENT=100

# =============================================================================
# LOGGING & OBSERVABILITY
# =============================================================================
# Structured JSON logging with correlation IDs for end-to-end tracing.
# NEVER log PHI - only opaque IDs and action metadata.

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Use INFO in production, DEBUG only in development
LOG_LEVEL=INFO

# Log format: json | console (json for production, console for local dev)
LOG_FORMAT=console

# =============================================================================
# ENCRYPTION
# =============================================================================
# Application-layer encryption for sensitive data cached in Redis.
# Database encryption (TDE) is configured at the PostgreSQL level.

# Encryption key for application-layer data encryption (Fernet key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_encryption_key_here

# =============================================================================
# TENANT DEFAULTS
# =============================================================================
# Default settings applied to new tenants at creation time.

# Default data residency region for new tenants
DEFAULT_DATA_RESIDENCY_REGION=af-south-1

# Default language for new tenants
DEFAULT_TENANT_LANGUAGE=en
